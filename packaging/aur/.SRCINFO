pkgbase = anoshell-git
	pkgdesc = Desktop shell for Wayland compositors (Hyprland, niri, sway, mango, labwc, Umbriel), built on Quickshell
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/AnoRebel/AnoShell
	install = anoshell.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = git
	makedepends = go>=2:1.27
	depends = quickshell
	depends = qt6-5compat
	depends = qt6-multimedia
	depends = awww
	depends = matugen
	depends = jq
	depends = brightnessctl
	depends = networkmanager
	depends = cliphist
	depends = wl-clipboard
	depends = curl
	depends = openssl
	depends = iproute2
	depends = libnotify
	depends = python
	depends = xdg-utils
	depends = util-linux
	depends = procps-ng
	depends = glib2
	optdepends = pipewire: volume, device pickers, privacy indicators, sounds
	optdepends = wireplumber: volume and audio devices
	optdepends = qt6-positioning: automatic location (with geoclue)
	optdepends = geoclue: automatic location
	optdepends = ddcutil: external monitor brightness
	optdepends = udisks2: removable drives module
	optdepends = wlsunset: night light
	optdepends = cava: audio spectrum
	optdepends = grim: screenshots
	optdepends = slurp: screenshot regions
	optdepends = tesseract: text recognition in screenshots
	optdepends = tesseract-data-eng: English text recognition
	optdepends = wf-recorder: screen recording
	optdepends = hyprpicker: colour picker
	optdepends = libqalculate: launcher calculator
	optdepends = fd: launcher file search
	optdepends = zenity: AnoSpot "Move to…" file picker
	optdepends = ydotool: paste from the clipboard history
	optdepends = translate-shell: translator
	optdepends = ffmpeg: video wallpaper stills
	optdepends = imagemagick: palette cursors and icons
	optdepends = librsvg: palette cursors and icons
	optdepends = qt6ct: Qt apps in the palette
	optdepends = kvantum: Qt apps in the palette (Kvantum mode)
	optdepends = pacman-contrib: package update count
	optdepends = songrec: music recognition
	optdepends = kdeconnect: phone integration
	optdepends = fprintd: fingerprint unlock
	optdepends = gamemode: game mode indicator
	optdepends = easyeffects: EasyEffects toggle and presets
	optdepends = sound-theme-freedesktop: battery and alarm sounds
	optdepends = xdg-desktop-portal: file pickers and screen sharing
	provides = anoshell
	conflicts = anoshell
	source = AnoShell::git+https://github.com/AnoRebel/AnoShell.git#branch=main
	sha256sums = SKIP

pkgname = anoshell-git
