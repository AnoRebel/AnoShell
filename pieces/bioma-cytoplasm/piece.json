{
  "id": "bioma-cytoplasm",
  "name": "Cytoplasm",
  "description": "Running applications as cells sized by memory, streaming with processor load (a Bioma organism)",
  "author": "Bioma, ported to AnoShell",
  "version": "1.0.0",
  "entry": "BiomaCytoplasmPiece.qml",
  "size": {
    "w": 4,
    "h": 2
  },
  "minSize": {
    "w": 3,
    "h": 2
  },
  "settings": [
    {
      "key": "count",
      "type": "int",
      "label": "Applications shown",
      "default": 6
    },
    {
      "key": "colour",
      "type": "choice",
      "label": "Colour",
      "options": [
        "state",
        "theme"
      ],
      "default": "state"
    },
    {
      "key": "labels",
      "type": "bool",
      "label": "Show names",
      "default": true
    }
  ]
}
