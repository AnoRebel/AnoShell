{
  "panelFamily": "ano",
  "enabledPanels": [],
  "familyTransitionAnimation": true,
  "compositor": {
    "backend": "auto"
  },
  "display": {
    "primaryMonitor": ""
  },
  "appearance": {
    "bezel": 0,
    "extraBackgroundTint": false,
    "fonts": {
      "main": "Google Sans",
      "numbers": "Google Sans",
      "title": "Google Sans Display",
      "expressive": "Space Grotesk",
      "iconNerd": "JetBrainsMono NF",
      "monospace": "JetBrainsMono NF",
      "reading": "Readex Pro"
    },
    "colors": {
      "darkMode": true,
      "schemeType": "tonal-spot"
    },
    "connectedCorners": {
      "enable": false,
      "radius": 18,
      "thickness": 7,
      "manageGaps": true,
      "floatingGapsOut": 5,
      "opacity": 1.0,
      "blur": false
    },
    "glass": {
      "enable": false,
      "tint": 0.55,
      "edgeLight": 0.6,
      "refraction": 0.5
    },
    "shadows": {
      "enable": false,
      "intensity": 1.0,
      "opacity": 1.0
    }
  },
  "animations": {
    "enable": true,
    "speed": 1.0,
    "reducedMotion": false,
    "batterySaver": false
  },
  "bars": [
    {
      "id": "main",
      "edge": "top",
      "modules": {
        "left": [
          "sidebarButton",
          "activeWindow"
        ],
        "center": [
          "workspaces"
        ],
        "right": [
          "clock",
          "battery",
          "network",
          "bluetooth",
          "tray",
          "sidebarButton"
        ]
      },
      "autoHide": null,
      "showBackground": null,
      "morphingPanel": false,
      "height": null,
      "radius": null,
      "leftSpacing": null,
      "centerSpacing": null,
      "rightSpacing": null,
      "edgePadding": null,
      "centerGroupPadding": null,
      "centerGroupRadius": null,
      "showCenterBackground": null,
      "showSeparators": null,
      "leftClickAction": null,
      "rightClickAction": null,
      "centerClickAction": null,
      "scrollLeftAction": null,
      "scrollRightAction": null,
      "scrollCenterAction": null
    }
  ],
  "bar": {
    "style": "pill",
    "cornerStyle": 0,
    "morphingPanels": false,
    "autoHide": {
      "enable": false
    },
    "showBackground": true,
    "verbose": true,
    "screenList": [],
    "workspaces": {
      "shown": 10
    },
    "layout": {
      "height": 42,
      "radius": 12,
      "leftSpacing": 8,
      "centerSpacing": 4,
      "rightSpacing": 8,
      "edgePadding": 8,
      "centerGroupPadding": 5,
      "centerGroupRadius": 8,
      "showCenterBackground": true,
      "showSeparators": false
    },
    "actions": {
      "leftClick": "none",
      "rightClick": "none",
      "centerClick": "overview",
      "scrollLeft": "brightness",
      "scrollRight": "volume",
      "scrollCenter": "workspace"
    },
    "weather": {
      "enable": false,
      "city": "",
      "useUSCS": false,
      "fetchInterval": 15
    }
  },
  "sidebar": {
    "instantOpen": false,
    "keepLeftSidebarLoaded": true,
    "keepRightSidebarLoaded": true,
    "quickSliders": {
      "showBrightness": true,
      "showVolume": true,
      "showMic": false
    },
    "right": {
      "enabledWidgets": [
        "systemButtons",
        "quickSliders",
        "quickToggles",
        "networkDetail",
        "media",
        "notifications",
        "calendar",
        "systemInfo"
      ]
    }
  },
  "overview": {
    "layout": "smartgrid"
  },
  "audio": {
    "protection": {
      "enable": true,
      "maxAllowedIncrease": 10,
      "maxAllowed": 100
    },
    "spectrum": {
      "bars": 32,
      "frameRate": 60
    },
    "easyEffects": {
      "enable": false
    }
  },
  "battery": {
    "low": 20,
    "critical": 10,
    "suspend": 5,
    "full": 100,
    "automaticSuspend": false
  },
  "time": {
    "format": "hh:mm",
    "secondPrecision": false,
    "shortDateFormat": "dd/MM",
    "dateFormat": "dddd, dd/MM",
    "dateWithYearFormat": "dd/MM/yyyy"
  },
  "notifications": {
    "timeout": 7000,
    "position": "topRight",
    "edgeMargin": 8,
    "expressiveAnimations": true
  },
  "osd": {
    "timeout": 1500,
    "position": "bottom",
    "indicators": {
      "volume": true,
      "brightness": true,
      "mic": true,
      "media": true,
      "keyboard": true,
      "network": true,
      "lockKeys": true
    }
  },
  "hud": {
    "enable": true
  },
  "tray": {
    "filterPassive": false,
    "invertPinnedItems": false,
    "pinnedItems": [],
    "showItemId": false
  },
  "media": {
    "filterDuplicatePlayers": true
  },
  "screenFilter": {
    "mode": "none",
    "last": "grayscale"
  },
  "notepad": {
    "enable": false
  },
  "todo": {
    "enable": false,
    "file": ""
  },
  "screenshot": {
    "copyOnCapture": true,
    "previewEdge": "bottomRight",
    "previewSeconds": 6,
    "onTimeout": "keep",
    "saveDir": ""
  },
  "screenTime": {
    "enable": false,
    "keepDays": 30,
    "idleSeconds": 120
  },
  "pomodoro": {
    "enable": false,
    "focusMinutes": 25,
    "breakMinutes": 5,
    "longBreakMinutes": 15,
    "cyclesBeforeLongBreak": 4
  },
  "stickyNotes": {
    "enable": false,
    "clickThrough": false,
    "x": 40,
    "y": 80,
    "width": 280,
    "height": 220
  },
  "settings": {
    "showAdvanced": false
  },
  "onboarding": {
    "seen": false
  },
  "cursor": {
    "theme": "",
    "size": 24
  },
  "reader": {
    "enable": false,
    "idleTimeout": 120,
    "cacheMB": 64,
    "metaCacheEntries": 512,
    "python": "python3",
    "novel": {
      "enable": true,
      "edge": "right"
    },
    "manga": {
      "enable": true,
      "edge": "left"
    },
    "anime": {
      "enable": true,
      "edge": "left"
    },
    "providers": {
      "freewebnovel": {
        "backend": "go"
      },
      "weebcentral": {
        "backend": "go"
      },
      "allanime": {
        "backend": "go"
      }
    }
  },
  "background": {
    "wallpaperPath": "",
    "wallpaperDir": "",
    "favourites": [],
    "picker": {
      "livePreview": true
    },
    "wallhaven": {
      "categories": "111",
      "purity": "100",
      "sorting": "date_added",
      "order": "desc",
      "topRange": "1M"
    },
    "resize": "fit",
    "engine": "awww",
    "video": {
      "allScreens": false
    },
    "hooks": [
      {
        "name": "pywal",
        "enable": true,
        "command": [
          "wal",
          "-i",
          "{image}",
          "-n",
          "-q"
        ],
        "timeoutSeconds": 30
      },
      {
        "name": "swaync",
        "enable": true,
        "command": [
          "swaync-client",
          "--reload-css"
        ]
      },
      {
        "name": "apps",
        "enable": true,
        "command": [
          "~/.config/quickshell/ano/scripts/colors/applycolor.sh",
          "--mode",
          "{mode}"
        ],
        "timeoutSeconds": 30
      },
      {
        "name": "cava",
        "enable": true,
        "builtin": "cava"
      },
      {
        "name": "themes",
        "enable": true,
        "command": [
          "~/.config/awww/scripts/awww_generate_themes.sh"
        ],
        "timeoutSeconds": 30
      }
    ],
    "randomize": {
      "enable": false,
      "directory": "",
      "interval": 300
    },
    "transition": {
      "enable": true,
      "type": "crossfade",
      "duration": 800,
      "direction": "right"
    }
  },
  "light": {
    "device": ""
  },
  "sounds": {
    "battery": true,
    "theme": "freedesktop"
  },
  "resources": {
    "updateInterval": 3000,
    "historyLength": 60
  },
  "ai": {
    "defaultModel": "gemini-2.5-flash",
    "temperature": 0.5,
    "systemPrompt": "You are a helpful assistant integrated into a Linux desktop shell called Ano. Be concise and use markdown formatting.",
    "models": {}
  },
  "gameMode": {
    "enable": false
  },
  "deviceEvents": {
    "enable": true,
    "bluetooth": true,
    "usb": true,
    "audio": true,
    "displays": true
  },
  "updates": {
    "enable": false,
    "intervalMin": 120,
    "command": ""
  },
  "performance": {
    "onGameMode": true,
    "onFullscreen": false,
    "stopAnimations": true,
    "stopBlur": true,
    "stopVisualizers": true,
    "holdPopups": true
  },
  "powerProfiles": {
    "restoreOnStart": true,
    "preferredProfile": ""
  },
  "network": {
    "panelStyle": "classic",
    "usage": {
      "enable": false,
      "intervalMs": 1000,
      "historyLength": 30
    },
    "hotspot": {
      "ssid": "AnoHotspot",
      "password": ""
    }
  },
  "vpn": {
    "enable": true,
    "notifyOnChange": true,
    "providers": []
  },
  "nightLight": {
    "enable": false,
    "schedule": "off",
    "dayTemp": 6500,
    "nightTemp": 4000,
    "start": "20:00",
    "end": "07:00",
    "fade": 30,
    "gamma": 1.0,
    "outputs": []
  },
  "shell": {
    "preferred": "",
    "hugePages": false
  },
  "calendar": {
    "upcomingDays": 7,
    "externalSync": {
      "enable": false,
      "refreshMinutes": 15,
      "sources": []
    },
    "holidays": {
      "enable": false,
      "autoDetect": true,
      "fallbackCountry": "TZ",
      "country": "",
      "color": "#E06C75"
    },
    "events": {
      "enable": true
    }
  },
  "lock": {
    "enable": true,
    "notifications": {
      "enable": false,
      "maxItems": 5
    },
    "osk": {
      "enable": false
    },
    "statusRow": {
      "enable": false
    },
    "dim": {
      "enable": true,
      "idleMs": 30000,
      "opacity": 0.6
    },
    "passwordInput": {
      "expandOnFocus": true
    }
  },
  "altSwitcher": {
    "style": "fan"
  },
  "lyrics": {
    "enable": false,
    "visible": true,
    "backend": "Auto",
    "dir": "~/.config/anoshell/lyrics"
  },
  "screenCorners": {
    "enable": false,
    "dwellMs": 300,
    "hitSize": 2,
    "actions": {
      "topLeft": "sidebarLeftOpen",
      "topRight": "sidebarRightOpen",
      "bottomLeft": "overviewOpen",
      "bottomRight": "settingsOpen"
    }
  },
  "recording": {
    "backend": "auto",
    "dir": "",
    "audio": false
  },
  "anoSpot": {
    "enable": false,
    "position": "bottom",
    "widthPx": 420,
    "heightPx": 36,
    "showMpris": true,
    "showNotification": true,
    "showRecording": true,
    "showClockWeather": true,
    "showBattery": true,
    "showWorkspace": true,
    "notificationTimeoutMs": 4000,
    "actions": {
      "leftClick": "mediaControls",
      "rightClick": "controlPanel",
      "middleClick": "anoview",
      "scrollOnMpris": "audio"
    },
    "eventBorder": {
      "enable": true,
      "holdMs": 1500,
      "events": [
        "notification",
        "track",
        "recording",
        "workspace"
      ]
    },
    "draggable": true,
    "acceptDrops": true,
    "stashDir": "",
    "dropTargets": [],
    "showLyrics": false,
    "accordion": true,
    "faces": {
      "media": true,
      "spectrum": false,
      "lyrics": false
    },
    "transients": {
      "volume": true,
      "brightness": true,
      "mic": true,
      "keyboard": true,
      "notification": true,
      "charging": true,
      "recording": true,
      "device": true
    },
    "growInto": {
      "mediaControls": false,
      "controlPanel": false,
      "calendar": false
    },
    "workspaceHoverPreview": {
      "enable": true,
      "openDelayMs": 200,
      "closeDelayMs": 300,
      "thumbnailWidth": 180,
      "thumbnailHeight": 110
    }
  },
  "interactions": {
    "scrolling": {
      "fasterTouchpadScroll": false,
      "touchpadScrollFactor": 100,
      "mouseScrollFactor": 50,
      "mouseScrollDeltaThreshold": 120
    }
  },
  "user": {
    "avatarPath": ""
  },
  "apps": {
    "terminal": "kitty",
    "fileManager": "nemo",
    "browser": "zen-browser"
  },
  "focusTime": {
    "enable": true,
    "excludeApps": [
      "Quickshell",
      "Locked",
      "Desktop",
      "Unknown"
    ]
  },
  "displayManager": {
    "enable": true
  },
  "hacks": {
    "arbitraryRaceConditionDelay": 100
  },
  "dock": {
    "enable": true,
    "style": "pill",
    "position": "auto",
    "height": 56,
    "iconSize": 40,
    "pinnedOnStartup": false,
    "hoverToReveal": true,
    "showOnDesktop": true,
    "screenList": [],
    "pinnedApps": [
      "kitty",
      "nemo",
      "zen-browser",
      "brave-browser"
    ]
  },
  "disabledPanels": [],
  "search": {
    "plugins": {
      "calculator": {
        "enable": false
      },
      "emoji": {
        "enable": false
      },
      "packages": {
        "enable": false,
        "helper": ""
      },
      "actions": {
        "enable": false,
        "enableDangerous": false,
        "items": [
          {
            "name": "Lock screen",
            "icon": "lock",
            "command": [
              "loginctl",
              "lock-session"
            ],
            "dangerous": false
          },
          {
            "name": "Suspend",
            "icon": "bedtime",
            "command": [
              "systemctl",
              "suspend"
            ],
            "dangerous": false
          },
          {
            "name": "Reboot",
            "icon": "restart_alt",
            "command": [
              "systemctl",
              "reboot"
            ],
            "dangerous": true
          },
          {
            "name": "Power off",
            "icon": "power_settings_new",
            "command": [
              "systemctl",
              "poweroff"
            ],
            "dangerous": true
          }
        ]
      },
      "schemes": {
        "enable": false
      },
      "looks": {
        "enable": false
      }
    }
  }
}
