{
  "_comment": "Default-app catalogue for Settings and `ano run` (spec default-apps). Order is the preference order: with nothing chosen, or the chosen app missing, the first installed one is used. `command` is what runs; `packages` names the package per package manager (aur: via yay/paru).",
  "terminal": [
    {
      "command": "kitty",
      "name": "kitty",
      "packages": {
        "pacman": "kitty",
        "apt": "kitty",
        "dnf": "kitty"
      },
      "exec": [],
      "appId": [
        "--class",
        "{id}"
      ]
    },
    {
      "command": "ghostty",
      "name": "Ghostty",
      "packages": {
        "pacman": "ghostty",
        "dnf": "ghostty"
      },
      "exec": [
        "-e"
      ],
      "appId": [
        "--class={id}"
      ]
    },
    {
      "command": "alacritty",
      "name": "Alacritty",
      "packages": {
        "pacman": "alacritty",
        "apt": "alacritty",
        "dnf": "alacritty"
      },
      "exec": [
        "-e"
      ],
      "appId": [
        "--class",
        "{id}"
      ]
    },
    {
      "command": "foot",
      "name": "foot",
      "packages": {
        "pacman": "foot",
        "apt": "foot",
        "dnf": "foot"
      },
      "exec": [],
      "appId": [
        "--app-id",
        "{id}"
      ]
    },
    {
      "command": "wezterm",
      "name": "WezTerm",
      "packages": {
        "pacman": "wezterm",
        "dnf": "wezterm"
      },
      "exec": [
        "start",
        "--"
      ],
      "appId": [
        "start",
        "--class",
        "{id}"
      ]
    },
    {
      "command": "konsole",
      "name": "Konsole",
      "packages": {
        "pacman": "konsole",
        "apt": "konsole",
        "dnf": "konsole"
      },
      "exec": [
        "-e"
      ]
    },
    {
      "command": "gnome-terminal",
      "name": "GNOME Terminal",
      "packages": {
        "pacman": "gnome-terminal",
        "apt": "gnome-terminal",
        "dnf": "gnome-terminal"
      },
      "exec": [
        "--"
      ]
    }
  ],
  "browser": [
    {
      "command": "zen-browser",
      "name": "Zen",
      "packages": {
        "aur": "zen-browser-bin"
      }
    },
    {
      "command": "firefox",
      "name": "Firefox",
      "packages": {
