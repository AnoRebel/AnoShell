        "dnf": "thunar"
      }
    },
    {
      "command": "dolphin",
      "name": "Dolphin",
      "packages": {
        "pacman": "dolphin",
        "apt": "dolphin",
        "dnf": "dolphin"
      }
    },
    {
      "command": "pcmanfm-qt",
      "name": "PCManFM-Qt",
      "packages": {
        "pacman": "pcmanfm-qt",
        "apt": "pcmanfm-qt",
        "dnf": "pcmanfm-qt"
      }
    }
  ]
