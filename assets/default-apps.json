        "dnf": "firefox"
      }
    },
    {
      "command": "brave",
      "name": "Brave",
      "packages": {
        "aur": "brave-bin"
      }
    },
    {
      "command": "chromium",
      "name": "Chromium",
      "packages": {
        "pacman": "chromium",
        "apt": "chromium",
        "dnf": "chromium"
      }
    },
    {
      "command": "google-chrome-stable",
      "name": "Google Chrome",
      "packages": {
        "aur": "google-chrome"
      }
    }
  ],
  "fileManager": [
    {
      "command": "nemo",
      "name": "Nemo",
      "packages": {
        "pacman": "nemo",
        "apt": "nemo",
        "dnf": "nemo"
      }
    },
    {
