      "name": "Files (Nautilus)",
      "packages": {
        "pacman": "nautilus",
        "apt": "nautilus",
        "dnf": "nautilus"
      }
    },
    {
      "command": "thunar",
      "name": "Thunar",
      "packages": {
        "pacman": "thunar",
