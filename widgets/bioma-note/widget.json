{
  "id": "bioma-note",
  "name": "Note",
  "description": "A Markdown file, read live and never written (a Bioma organism)",
  "author": "Bioma, ported to AnoShell",
  "version": "1.0.0",
  "entry": "BiomaNoteWidget.qml",
  "size": {
    "w": 4,
    "h": 4
  },
  "minSize": {
    "w": 3,
    "h": 3
  },
  "settings": [
    {
      "key": "file",
      "type": "string",
      "label": "Markdown file",
      "default": "~/notes.md"
    }
  ]
}
