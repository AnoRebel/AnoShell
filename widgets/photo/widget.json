{
  "id": "photo",
  "name": "Photo frame",
  "description": "A picture, or a slideshow of a folder",
  "author": "AnoShell",
  "version": "1.0.0",
  "entry": "PhotoWidget.qml",
  "size": { "w": 3, "h": 3 },
  "minSize": { "w": 2, "h": 2 },
  "frame": false,
  "settings": [
    { "key": "path", "type": "string", "label": "Picture or folder", "default": "~/Pictures" },
    { "key": "interval", "type": "int", "label": "Seconds per picture", "default": 30 },
    { "key": "shuffle", "type": "bool", "label": "Shuffle", "default": true }
  ]
}
